<% content_for :title, 'Exportação do relatório' %>

<main class="tela">
  <section class="tela-topo">
    <h1>Exportação do relatório</h1>
    <p id="flash-alert" class="flash flash-alert" role="alert"><%= @mensagem %></p>
    <% if current_user.perfil == 'administrador' %>
      <%= link_to 'Voltar ao relatório', caminho_voltar_relatorio, id: 'voltar-relatorio', class: 'botao-link' %>
    <% end %>
  </section>
</main>
