<% content_for :title, "Autenticação" %>

<main class="auth-page">
  <section class="auth-card">
    <h1>Autenticação</h1>
    <%= render "shared/flash" %>

    <%= form_with url: login_path, method: :post do |form| %>
      <div class="field">
        <%= form.label :matricula, "Matrícula" %>
        <%= form.text_field :matricula, inputmode: "numeric", maxlength: 9, autocomplete: "username" %>
      </div>
      <div class="field">
        <%= form.label :password, "Senha" %>
        <%= form.password_field :password, autocomplete: "current-password" %>
      </div>
      <%= form.submit "Entrar", class: "primary-button" %>
    <% end %>
  </section>
</main>
