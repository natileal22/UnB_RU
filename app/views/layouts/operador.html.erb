<!DOCTYPE html>
<html>
  <head>
    <title>UnB RU - Operacional</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="operador-layout">
    <% if current_user&.operador_autorizado? && controller_name != "sessoes" %>
      <%= render "operador/shared/navbar" if lookup_context.exists?("operador/shared/_navbar") %>
    <% end %>

    <%= yield %>
  </body>
</html>