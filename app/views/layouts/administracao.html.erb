<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "UnB RU" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
  </head>

  <body>
    <%# o menu unico por perfil da reserva, so aparece se a pasta app/salvaguarda existir %>
    <%= render "shared/navegacao" if lookup_context.exists?("shared/navegacao", [], true) %>

    <%= yield %>
  </body>
</html>
