<div class="auth-page">
  <header class="auth-header">
    <div class="brand-logo">
      <div class="logo-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="3" y="3" width="7" height="7"></rect>
          <rect x="14" y="3" width="7" height="7"></rect>
          <rect x="14" y="14" width="7" height="7"></rect>
          <rect x="3" y="14" width="7" height="7"></rect>
        </svg>
      </div>
      <div class="brand-text">
        <div class="brand-title-row">
          <span class="brand-title">RU UnB</span>
          <span class="badge-operacional">OPERACIONAL</span>
        </div>
        <span class="brand-subtitle">Campus Darcy Ribeiro • Piso 2</span>
      </div>
    </div>
  </header>

  <main class="auth-container">
    <div class="auth-card">
      <div class="card-icon">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#003380" stroke-width="2">
          <rect x="4" y="4" width="16" height="16" rx="2"></rect>
          <circle cx="12" cy="10" r="2"></circle>
          <path d="M8 16c0-2 4-2 4-2s4 0 4 2"></path>
        </svg>
      </div>

      <h1 class="card-title">Autenticação do Operador</h1>
      <p class="card-description">
        Informe suas credenciais funcionais para iniciar a sessão segura e liberar o terminal de catraca.
      </p>

      <% if flash[:alert] %>
        <div class="auth-alert" role="alert">
          <%= flash[:alert] %>
        </div>
      <% end %>
        <%= form_with url: operador_entrar_path, method: :post, local: true, html: { novalidate: true, class: "auth-form" } do |f| %>
        <div class="form-group">
            <div class="label-row">
            <%= f.label :matricula, "Matrícula SIAPE ou Usuário SIGAA / gov.br", class: "form-label" %>
            <span class="required-hint">Obrigatório</span>
            </div>
            <div class="input-wrapper">
            <span class="input-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2">
                <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                <circle cx="12" cy="7" r="4"></circle>
              </svg>
            </span>
            <%= f.text_field :matricula,
                    id: "matricula",
                    value: params[:matricula],
                    placeholder: "Ex: 1984201 ou operador.darcy",
                    class: "form-input" %>
            </div>
        </div>


        <div class="form-group">
          <div class="label-row">
            <%= f.label :senha, "Senha de Acesso", class: "form-label" %>
            <span class="required-hint">Obrigatório</span>
          </div>
          <div class="input-wrapper">
            <span class="input-icon">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
                <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
              </svg>
            </span>
            <%= f.password_field :senha,
                  id: "senha",
                  placeholder: "Digite sua senha de operador",
                  class: "form-input" %>
            <button type="button" class="toggle-password" onclick="const s = document.getElementById('senha'); s.type = s.type === 'password' ? 'text' : 'password';">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#555" stroke-width="2">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </button>
          </div>
        </div>

        <%= f.button type: "submit", class: "btn-submit" do %>
          <span>Entrar no Sistema</span>
        <% end %>
      <% end %>
    </div>
  </main>
</div>