<% content_for :title, "Histórico Local" %>
<%= stylesheet_link_tag "telas" %>

<main class="tela">
  <section class="tela-topo">
    <h1><%= titulo_historico(@resultado.catracas) %></h1>
    <p>
      Unidade: <%= @resultado.catracas.map { |c| c.restaurant.name }.uniq.join(", ") %>
    </p>
  </section>

  <% if flash[:alert] %>
    <p id="flash-alert" class="flash flash-alert" role="alert"><%= flash[:alert] %></p>
  <% end %>

  <% if @resultado.sem_catraca? %>
    <p id="aviso-sem-catraca" class="flash flash-alert" role="alert">
      Nenhuma catraca vinculada a você. Procure o administrador
    </p>
  <% else %>
    <% if @resultado.valido? %>
      <div class="cartoes">
        <%= render "shared/cartao_resumo", titulo: "Passagens", valor: @resultado.passagens,
                                           rodape: "giros confirmados no período" %>
        <%= render "shared/cartao_resumo", titulo: "Arrecadação local", valor: valor_br(@resultado.arrecadacao),
                                           rodape: "soma dos débitos liberados" %>
      </div>
    <% end %>

    <%= form_with url: operador_historico_index_path, method: :get, id: "filtro-periodo",
                  class: "barra-filtros" do |form| %>
      <div class="field">
        <%= form.label :data_inicial, "Data inicial" %>
        <%= form.text_field :data_inicial, value: params[:data_inicial], placeholder: "dd/mm/aaaa" %>
      </div>
      <div class="field">
        <%= form.label :data_final, "Data final" %>
        <%= form.text_field :data_final, value: params[:data_final], placeholder: "dd/mm/aaaa" %>
      </div>
      <div class="field">
        <%= form.label :resultado, "Status" %>
        <%= form.select :resultado, opcoes_de_status, selected: params[:resultado] %>
      </div>
      <%= form.submit "Filtrar", class: "primary-button" %>
    <% end %>

    <% if @resultado.valido? && @resultado.acessos.empty? %>
      <%= render "shared/lista_vazia", id: "acessos-vazio", texto: "Nenhum acesso registrado nesta catraca" %>
    <% elsif @resultado.valido? %>
      <table id="acessos" class="tabela">
        <thead>
          <tr><th>Data e hora</th><th>Catraca</th><th>Matrícula</th><th>Tarifa</th><th>Status</th></tr>
        </thead>
        <tbody>
          <% @resultado.acessos.each do |acesso| %>
            <% recusado = acesso.resultado != "LIBERADO" %>
            <tr class="<%= "linha-recusada" if recusado %>">
              <td><%= l(acesso.occurred_at, format: "%d/%m/%Y %H:%M") %></td>
              <td><%= acesso.catraca %></td>
              <td><%= acesso.matricula %></td>
              <td><%= valor_br(acesso.valor_cobrado || 0) %></td>
              <td>
                <%= render "shared/selo_status", texto: status_do_acesso(acesso), tipo: recusado ? "erro" : "ok" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  <% end %>
</main>
