# Modelo das variáveis de ambiente do UnB RU. Copie para .env e preencha com os dados do seu projeto no Supabase.
# O .env real fica só na sua máquina: ele está no .gitignore e nunca deve ir para o Git.

# Projeto Supabase (Configurações do projeto > API)
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=sua-anon-key-aqui

# Conexão do Rails (Configurações do projeto > Database > Connection string)
# Pooler Supavisor, modo transação (porta 6543). É a que o app usa no dia a dia.
# Não acrescente "?pgbouncer=true": esse parâmetro é do Prisma e o Rails/libpq o recusam. O app percebe a porta 6543 e
# desliga prepared_statements sozinho; o sslmode=require vem do host remoto.
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Conexão direta ou pooler em modo sessão (porta 5432). Use para migrações (db:migrate) se o modo transação reclamar.
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Alternativa à DATABASE_URL: campos separados
# SUPABASE_DB_HOST=aws-0-sa-east-1.pooler.supabase.com
# SUPABASE_DB_PORT=6543
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres.[PROJECT-REF]
# SUPABASE_DB_PASSWORD=sua-senha-aqui

# Banco de TESTE: sempre local, nunca o Supabase. A DATABASE_URL é ignorada quando RAILS_ENV=test.
# TEST_DB_HOST=localhost
# TEST_DB_PORT=5432
# TEST_DB_NAME=unb_ru_test
# TEST_DB_USER=postgres
# TEST_DB_PASSWORD=
