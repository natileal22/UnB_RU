# Modelo das variáveis de ambiente do UnB RU. Copie para .env e preencha.
# O .env real fica só na sua máquina: ele está no .gitignore e nunca deve ir para o Git.
#
# Sem nenhuma conexão remota configurada, o app usa o PostgreSQL local (localhost:5432, usuário postgres).
# Para outra porta ou host locais:
# DB_HOST=localhost
# DB_PORT=5432

# --- Supabase (descomente só quando for usar o banco remoto) ---
# Cuidado: com a DATABASE_URL ativa, o desenvolvimento passa a usar o banco do Supabase, que é compartilhado.
# Tarefas que apagam o banco (db:drop, db:reset, db:setup, db:schema:load, db:purge) recusam rodar contra servidor remoto
# a menos que você declare PERMITIR_BANCO_REMOTO=sim. O banco de teste nunca usa o Supabase.

# Pooler Supavisor, modo transação (porta 6543). É a conexão do dia a dia.
# Não acrescente "?pgbouncer=true": esse parâmetro é do Prisma e o libpq recusa a conexão. O app percebe a porta 6543
# e desliga prepared_statements e advisory_locks sozinho; o sslmode=require vem do host remoto.
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Conexão direta (porta 5432). O Rails não lê esta variável. Para rodar migrações (db:migrate), troque a DATABASE_URL
# acima por este valor durante a migração e volte depois.
# DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Alternativa à DATABASE_URL: campos separados
# SUPABASE_DB_HOST=aws-0-sa-east-1.pooler.supabase.com
# SUPABASE_DB_PORT=6543
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres.[PROJECT-REF]
# SUPABASE_DB_PASSWORD=sua-senha-aqui

# Só serão usadas se o projeto passar a chamar a API do Supabase (por exemplo, com o cliente JavaScript). O Rails não as lê.
# SUPABASE_URL=https://seu-projeto.supabase.co
# SUPABASE_ANON_KEY=sua-anon-key-aqui

# --- Banco de TESTE: sempre local, nunca o Supabase ---
# A DATABASE_URL é ignorada quando RAILS_ENV=test, e TEST_DB_HOST precisa ser local.
# TEST_DB_HOST=localhost
# TEST_DB_PORT=5432
# TEST_DB_NAME=unb_ru_test
# TEST_DB_USER=postgres
# TEST_DB_PASSWORD=
