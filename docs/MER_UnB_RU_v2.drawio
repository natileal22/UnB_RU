        <mxCell id="c5" parent="c4" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=nowrap;overflow=hidden;spacingLeft=6;" value="&lt;font face=&#39;Courier New&#39;&gt;&lt;b&gt;PK&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;id&lt;/b&gt;&amp;nbsp;INTEGER&lt;/font&gt;&lt;br&gt;&lt;font face=&#39;Courier New&#39;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;nome&amp;nbsp;VARCHAR(120) NOT NULL&lt;/font&gt;&lt;br&gt;&lt;font face=&#39;Courier New&#39;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;localizacao&amp;nbsp;VARCHAR(120) NOT NULL&lt;/font&gt;&lt;br&gt;&lt;font face=&#39;Courier New&#39;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;capacidade_ref_hora&amp;nbsp;INTEGER NOT NULL  [HIPÓTESE]&lt;/font&gt;&lt;br&gt;&lt;font face=&#39;Courier New&#39;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;horario_abertura&amp;nbsp;TIME NOT NULL  [PROVISÓRIO]&lt;/font&gt;&lt;br&gt;&lt;font face=&#39;Courier New&#39;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;horario_fechamento&amp;nbsp;TIME NOT NULL  [PROVISÓRIO]&lt;/font&gt;&lt;br&gt;&lt;font face=&#39;Courier New&#39;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;status&amp;nbsp;VARCHAR(7) NOT NULL DEFAULT &amp;#x27;ativo&amp;#x27;&lt;/font&gt;&lt;br&gt;&lt;font face=&#39;Courier New&#39;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;created_at&amp;nbsp;TIMESTAMP NOT NULL&lt;/font&gt;&lt;br&gt;&lt;font face=&#39;Courier New&#39;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;updated_at&amp;nbsp;TIMESTAMP NOT NULL&lt;/font&gt;" vertex="1">
          <mxGeometry height="159" width="430" y="32" as="geometry" />
        </mxCell>
        <mxCell id="c6" parent="c4" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#444444;whiteSpace=nowrap;overflow=hidden;spacingLeft=6;fillColor=#f5f5f5;strokeColor=#cccccc;" value="UNIQUE índice em lower(trim(nome))&lt;br&gt;CHECK length(trim(nome)) &amp;gt; 0 e length(trim(localizacao)) &amp;gt; 0&lt;br&gt;CHECK capacidade_ref_hora BETWEEN 1 AND 5000&lt;br&gt;CHECK horario_abertura &amp;lt; horario_fechamento&lt;br&gt;CHECK status IN (&amp;#x27;ativo&amp;#x27;,&amp;#x27;inativo&amp;#x27;)" vertex="1">
          <mxGeometry height="85" width="430" y="193" as="geometry" />
        </mxCell>
