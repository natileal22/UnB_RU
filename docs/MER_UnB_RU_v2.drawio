        <mxCell id="c9" parent="c7" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#444444;whiteSpace=nowrap;overflow=hidden;spacingLeft=6;fillColor=#f5f5f5;strokeColor=#cccccc;" value="FK restaurante_id → restaurantes.id ON DELETE RESTRICT&lt;br&gt;UNIQUE (restaurante_id, lower(trim(codigo)))&lt;br&gt;CHECK codigo: só letras, dígitos e hífen&lt;br&gt;CHECK piso IS NULL OR piso &amp;gt;= 1&lt;br&gt;CHECK status IN (&amp;#x27;ativa&amp;#x27;,&amp;#x27;inativa&amp;#x27;,&amp;#x27;em_manutencao&amp;#x27;)" vertex="1">
          <mxGeometry height="85" width="470" y="176" as="geometry" />
