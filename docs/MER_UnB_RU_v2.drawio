        <mxCell id="c8" parent="c7" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=nowrap;overflow=hidden;spacingLeft=6;" value="&lt;font face=&#39;Courier New&#39;&gt;&lt;b&gt;PK&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;id&lt;/b&gt;&amp;nbsp;INTEGER&lt;/font&gt;&lt;br&gt;&lt;font face=&#39;Courier New&#39;&gt;&lt;b&gt;FK&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;b&gt;restaurante_id&lt;/b&gt;&amp;nbsp;INTEGER NOT NULL&lt;/font&gt;&lt;br&gt;&lt;font face=&#39;Courier New&#39;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;codigo&amp;nbsp;VARCHAR(20) NOT NULL&lt;/font&gt;&lt;br&gt;&lt;font face=&#39;Courier New&#39;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;piso&amp;nbsp;SMALLINT NULL  [HIPÓTESE; nulo = &amp;quot;Sem piso&amp;quot;]&lt;/font&gt;&lt;br&gt;&lt;font face=&#39;Courier New&#39;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;corredor_fastpass&amp;nbsp;BOOLEAN NOT NULL DEFAULT false&lt;/font&gt;&lt;br&gt;&lt;font face=&#39;Courier New&#39;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;status&amp;nbsp;VARCHAR(13) NOT NULL&lt;/font&gt;&lt;br&gt;&lt;font face=&#39;Courier New&#39;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;created_at&amp;nbsp;TIMESTAMP NOT NULL&lt;/font&gt;&lt;br&gt;&lt;font face=&#39;Courier New&#39;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;updated_at&amp;nbsp;TIMESTAMP NOT NULL&lt;/font&gt;" vertex="1">
