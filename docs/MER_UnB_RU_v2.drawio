        <mxCell id="c23" parent="1" style="text;html=1;fontSize=10;align=center;fontColor=#666666;" value="(0,N)" vertex="1">
          <mxGeometry height="16" width="44" x="99.5" y="362" as="geometry" />
        </mxCell>
        <mxCell id="c24" parent="1" style="text;html=1;fontSize=10;align=center;fontColor=#666666;" value="(1,1)" vertex="1">
          <mxGeometry height="16" width="44" x="99.5" y="450" as="geometry" />
